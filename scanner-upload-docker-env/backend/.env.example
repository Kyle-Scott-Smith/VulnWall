# Template for backend/.env — safe to commit, contains NO real secrets.
#
#   cp backend/.env.example backend/.env      (macOS/Linux)
#   Copy-Item backend/.env.example backend/.env   (Windows PowerShell)
#
# docker-compose.yml loads backend/.env into the backend container (env_file).
# The app starts with everything below left blank; each optional integration
# (Tenable, Jira, Google sign-in, email) simply reports "not configured"
# until its values are filled in. NEVER commit backend/.env itself.

# --- Flask (scanner.py) ---
# Set a fixed value so logins/Jira sessions survive backend reloads.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- AI analysis & chatbot via local Ollama (ollama_client.py, ai_analysis.py, chatbot.py) ---
# Must match the model pulled by the ollama-pull service in docker-compose.yml.
# OLLAMA_HOST is set in docker-compose.yml (http://ollama:11434); only set it
# here if you point at an Ollama server running somewhere else.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_ANALYSIS_CONCURRENCY=4
CHAT_MAX_CONTEXT_VULNS=300

# --- Tenable.io cross-reference (tenable_client.py, scanners/tenable.py) — optional ---
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_BASE_URL=https://cloud.tenable.com

# --- Jira OAuth integration (jira_integration.py) — optional ---
# From your app in the Atlassian Developer Console (see README-jira-integration.md).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_CALLBACK_URL=http://localhost:5000/api/jira/callback
JIRA_FRONTEND_RETURN_URL=http://localhost:5173/?jira=connected
JIRA_DEFAULT_PROJECT_KEY=VULN

# --- Google Sign-In (google_auth.py) — optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_FRONTEND_RETURN_URL=http://localhost:5173/

# --- Email: scan alerts + MFA codes (email_notifications.py, mfa.py) ---
# Defaults below use the bundled Mailpit container (dev only): no account
# needed, and every "sent" email appears at http://localhost:8025.
# For real delivery use e.g. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USE_TLS=true plus a username/app password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left blank; required when using Mailpit.
SMTP_FROM_EMAIL=scanner@example.local
SMTP_USE_TLS=false
