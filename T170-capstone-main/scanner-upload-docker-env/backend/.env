# Copy of the environment variables the backend reads (see docker-compose.yml
# env_file). Fill in real values for the features you want enabled — Compose
# will start fine with these left blank, but Tenable/AI/Jira features will
# report "not configured" until their keys are set.

# --- Anthropic / AI analysis & chatbot (ai_analysis.py, chatbot.py) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
AI_MAX_RETRIES=2
CHAT_MAX_TOKENS=600
CHAT_MAX_CONTEXT_VULNS=300

# --- Tenable (tenable_client.py, scanners/tenable.py) ---
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_BASE_URL=https://cloud.tenable.com

# --- Jira OAuth integration (jira_integration.py) ---
JIRA_CLIENT_ID=bh7jQ0sQtzFprEpIBZBt2VYVaK988n8N
JIRA_CLIENT_SECRET=ATOANDiYfBRCNjNm-q0Vjbn3s9MdTcvH6z0hnHSfTo--OBDc5S_4yqCkKn1X7IzzqQhVC4D3E723
JIRA_CALLBACK_URL=http://localhost:5000/api/jira/callback
JIRA_FRONTEND_RETURN_URL=http://localhost:5173/?jira=connected
